# =====================================================
# منصة مدرسة أزاد الإلكترونية — قالب إعدادات البيئة
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية.
# لا ترفع .env أبداً إلى Git (انظر .gitignore — D4).
# =====================================================

# ---- التطبيق ----
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=غيّرني-بمفتاح-عشوائي-طويل-جداً

# ---- قاعدة البيانات (PostgreSQL) ----
# مثيل محلي مخصص للمنصة (تم إعداده على المنفذ 5433)
DATABASE_URL=postgresql+psycopg2://postgres:كلمة-المرور@localhost:5433/azad_e_school

# ---- اللغة الافتراضية ----
# ar | en
DEFAULT_LOCALE=ar

# ---- البريد (لاحقاً — تفعيل الحساب وإعادة التعيين) ----
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=azad@example.com

# ---- الدفع (M9 لاحقاً — لا تُفعَّل قبل الاعتماد الصريح - D12) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ---- النسخ الاحتياطي اليومي (M6+) ----
BACKUP_DIR=backups
