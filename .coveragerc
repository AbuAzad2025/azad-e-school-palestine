[run]
source = app
branch = True
omit =
    app/migrations/*
    app/models/__init__.py
    app/modules/*/forms.py
    app/modules/*/__init__.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if TYPE_CHECKING:
    if __name__ == .__main__.
    raise NotImplementedError
    pass
    @overload
show_missing = True
# pytest-cov's fail_under measures combined (lines+branches) precision, NOT
# line-only. Current: 91% line / 79% branch => combined 90.74%. Floor must
# track scripts/coverage_gaps.py's line-based backend floor (93.216%) minus
# the combined-vs-line delta. Raise only after a green run verifies it.
fail_under = 90
