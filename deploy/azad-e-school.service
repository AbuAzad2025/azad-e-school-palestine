[Unit]
Description=Azad E-School Platform
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=azad
Group=azad
WorkingDirectory=/opt/azad-e-school
Environment=PATH=/opt/azad-e-school/.venv/bin
ExecStart=/opt/azad-e-school/.venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 run:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target